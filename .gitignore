# Files from Forge MDK
forge*changelog.txt

# Downloaded development-only render mods and shader packs.
.dependencies/

# Runtime data, worlds, logs, and data-generator working directories.
/run-data/
/logs/
/crash-reports/

# Generated screenshots, texture studies, and preview archives.
# Game-ready textures belong in src/main/resources and remain tracked.
/art/

# Local artwork sources and generation references.
/art-source/

# Data-generator cache; keep generated registry JSON tracked.
/src/generated/resources/.cache/

# Python tooling caches and virtual environments.
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets and operating-system metadata.
.env
.env.*
!.env.example
Thumbs.db
Desktop.ini
.DS_Store

# Parked Git metadata must never be committed.
/.git_dis/

# Local concept art, generation references and runtime screenshots.
# Keep the public README banner; shipped textures live in src/main/resources.
/docs/assets/*
!/docs/assets/tidal-terror-banner.png

# Unused original Forge MDK changelog.
/changelog.txt

# Retain documented native visual evidence, but ignore artwork source images.
!/docs/assets/deep-cathedral-garden-2026-10-09.png
!/docs/assets/reef-compass/
/docs/assets/reef-compass/*
!/docs/assets/reef-compass/compass-pose-*.png

# Documentation and release notes use Markdown.
/README.txt
/CREDITS.txt
/docs/**/*.txt
/changelogs/*.txt

# Local artwork process notes and generation prompts.
/docs/*-Art-Workflow.md
/docs/*-art-workflow.md
/docs/*-material-prompt.md
